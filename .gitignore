# === mpv 运行时产生的临时状态（不纳入版本库）===
portable_config/_cache/
portable_config/saved-props.json

# === Python 字节码缓存（注意：不要排除 .pyd，那是运行必需的扩展模块）===
__pycache__/
*.pyc
*.pyo
*$py.class

# === 发布产物（构建脚本可随时重建） ===
release/

# === 编辑器 / 系统临时文件 ===
.idea/
.vscode/
.workbuddy/
*.swp
*.log
*.tmp
.DS_Store
Thumbs.db
